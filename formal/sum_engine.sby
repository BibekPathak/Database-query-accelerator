# ===========================================================================
#  sum_engine.sby -- bounded model check of the streaming SUM engine.
#
#  Run:  sby -f formal/sum_engine.sby
# ===========================================================================
[options]
mode bmc
depth 24

[engines]
smtbmc z3

[script]
read_verilog -formal -sv db_pkg_formal.sv sum_engine_f.sv sum_engine_formal.sv
prep -top sum_engine_formal

[files]
formal/db_pkg_formal.sv
formal/sum_engine_f.sv
formal/sum_engine_formal.sv
