/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.o
*.a

# Verilator output
*.log
*.d

# Waveform traces
*.vcd
*.vcd.gz
*.fst
*.fst.gz

# Generated benchmark / report artifacts (keep the directory itself)
/results/*
!/results/.gitkeep

